<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#8a4b6b">
<title>Gratitude Card Maker</title>
<link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600&family=Playfair+Display:ital@0;1&display=swap" rel="stylesheet">
<style>
:root{--bg:#fdf6f0;--ink:#3a2a33;--accent:#8a4b6b;--field:#fff;--line:#d9c9d1}
@media (prefers-color-scheme:dark){:root{--bg:#1f171c;--ink:#f3e8ee;--accent:#d58bb0;--field:#2b2026;--line:#463540}}
body{font-family:Arial,sans-serif;background:var(--bg);color:var(--ink);margin:0;padding:20px;text-align:center}
h1{font-family:"Dancing Script",cursive;color:var(--accent);font-size:2.2em;margin:.2em 0}
.box{max-width:420px;margin:auto}
select,input,textarea,button{width:100%;padding:12px;margin:8px 0;font-size:16px;border-radius:10px;border:1px solid var(--line);box-sizing:border-box;background:var(--field);color:var(--ink)}
input[type=radio]{width:auto;margin:0 10px 0 0;padding:0;vertical-align:middle}
label.r{display:block;text-align:left;padding:6px 0;font-size:15px}
button{background:var(--accent);color:#fff;border:none;cursor:pointer}
button.alt{background:transparent;color:var(--accent);border:1px solid var(--accent)}
#card{display:none;position:relative;overflow:hidden;margin-top:20px;padding:12px;border-radius:18px;box-shadow:0 6px 18px rgba(0,0,0,.25);animation:rise .8s ease}
#inner{position:relative;z-index:1;border:2px solid var(--gold);border-radius:12px;padding:26px 18px;outline:1px solid var(--gold);outline-offset:-8px}
#orn{font-size:26px;letter-spacing:6px}
#orn2{font-size:18px;letter-spacing:6px;margin-top:14px}
#title{font-family:"Dancing Script",cursive;font-size:2em;margin:.3em 0 .4em}
#msg{font-family:"Playfair Display",Georgia,serif;font-style:italic;font-size:17px;line-height:1.65;white-space:pre-wrap}
.brand{font-size:12px;margin-top:14px;opacity:.7}
.star{position:absolute;background:#fff;border-radius:50%;animation:tw 2.6s ease-in-out infinite;pointer-events:none}
@keyframes tw{0%,100%{opacity:.15}50%{opacity:1}}
@keyframes rise{from{opacity:0;transform:translateY(16px) scale(.97)}to{opacity:1;transform:none}}
</style>
</head>
<body>
<div class="box">
<h1>Gratitude Card Maker</h1>
<select id="occasion" onchange="setExtra()">
<option value="thank you">Thank you</option>
<option value="birthday">Birthday</option>
<option value="thinking of you">Thinking of you (love letter 💌)</option>
<option value="partner">Be my girlfriend / partner 💞</option>
<option value="marry">Marry me 💍</option>
<option value="date">Date invitation 🥂</option>
<option value="gift">A gift for you 🎁</option>
</select>
<div id="extra" style="display:none"><input id="x1"><input id="x2"><input id="x3"><input id="x4"></div>
<select id="style"></select>
<input id="name" placeholder="Their name">
<textarea id="words" rows="3" placeholder="What do you want to tell them? (optional, in your own words)"></textarea>
<button id="go" onclick="makeCard()">Make my card</button>
<div id="card"><div id="inner">
<div id="orn"></div><div id="title"></div><div id="msg"></div><div id="orn2"></div>
<div class="brand">Made with Gratitude Card Maker</div>
</div></div>
<div id="shareBox" style="display:none">
<button onclick="shareNow()" style="font-size:18px;padding:14px;margin-top:16px">Send it 💌</button>
<div id="status" style="min-height:1.4em;margin:6px 0;font-size:15px;font-weight:bold"></div>
<p style="margin:10px 0 2px;font-weight:bold">How should it arrive?</p>
<label class="r"><input type="radio" name="mode" value="card" checked>As this beautiful card</label>
<label class="r"><input type="radio" name="mode" value="plain">As a plain message, like I typed it myself</label>
<button class="alt" onclick="makeCard()">Try another wording</button>
<p style="font-size:13px;opacity:.75">Tap “Send it”, pick WhatsApp, Instagram, TikTok or any app, then choose the person.</p>
</div>
</div><script>
var ORDER=["t1","t2","t3","t4","t5","t6","t7","t8","t9","t10","t11"];
var TH={
t1:{n:"Rose garden",c1:"#ffe3ec",c2:"#ffc2d4",ink:"#5a2a3c",gold:"#c99a4b",orn:"🌸 🌷 🌸"},
t2:{n:"Golden hour",c1:"#fff1d0",c2:"#ffd9a0",ink:"#5a4318",gold:"#b8862b",orn:"🌻 ✨ 🌼"},
t3:{n:"Ocean calm",c1:"#dff0fa",c2:"#b5dcf2",ink:"#1f4663",gold:"#6aa5c9",orn:"🌊 🐚 💙"},
t4:{n:"Midnight stars",c1:"#232850",c2:"#0c0e22",ink:"#f6e6b8",gold:"#e3c26a",orn:"⭐ 🌙 ✨",stars:1},
t5:{n:"Lavender dream",c1:"#efe6ff",c2:"#d0bdf5",ink:"#3d2a63",gold:"#9a7bd1",orn:"💜 🦋 🌸"},
t6:{n:"Sunset blush",c1:"#ffd8c2",c2:"#f5a0b6",ink:"#6a2a2f",gold:"#d9805a",orn:"🌅 🌺 🧡"},
t7:{n:"Emerald garden",c1:"#e2f5e6",c2:"#b3dfc0",ink:"#1f4a33",gold:"#5aa376",orn:"🌿 🌼 🍃"},
t8:{n:"Red velvet",c1:"#7a1630",c2:"#38091a",ink:"#ffe9d6",gold:"#e8b86a",orn:"🌹 ❤️ 🌹"},
t9:{n:"Moonlight silver",c1:"#eef1f8",c2:"#c3cde3",ink:"#2c3550",gold:"#8a97b8",orn:"🌙 🤍 ✨"},
t10:{n:"Peach cream",c1:"#fff0e6",c2:"#ffcfb8",ink:"#5b3524",gold:"#d08b5f",orn:"🍑 🌷 🤍"},
t11:{n:"Aurora night",c1:"#12405a",c2:"#2a1650",ink:"#e6f7ff",gold:"#7fe0d0",orn:"🌌 ✨ 💫",stars:1}
};
(function(){var sel=document.getElementById("style");ORDER.forEach(function(k){var o=document.createElement("option");o.value=k;o.textContent=TH[k].n;sel.appendChild(o);});})();
var MID={"thinking of you":"💕","partner":"💞","marry":"💍","date":"🥂","gift":"🎁"};
function ornFor(s,o){var p=TH[s].orn.split(" ");return MID[o]?p[0]+" "+MID[o]+" "+p[2]:TH[s].orn;}
function ornSmall(s,o){return MID[o]?"🌷 💗 🌷":"🌼 🌿 🌼";}
var TPL={
"thank you":[
"{n}, I don’t say it often enough, but thank you. [[{w} means more to me than you know. ]]You make my life gentler just by being in it 🌷 I am truly grateful for you 💛",
"Dear {n}, some people change your days without even trying, and you are one of them. [[Thank you for {w}. ]]I carry your kindness with me 🌸 You are deeply appreciated 💛",
"{n}, I wanted you to know how much I value you. [[Thank you for {w}. ]]The world feels softer with you in it 🌼 With all my gratitude 💐"],
"birthday":[
"Happy birthday, {n}! 🎂 [[Thank you for {w}. ]]I hope today wraps you in all the joy you give to everyone around you 🌸 You deserve every good thing 💐",
"{n}, today the world celebrates you, and I am so glad you were born 🎉 [[I am thankful for {w}. ]]May this new year be gentle, bright and full of love 🌷",
"To {n}, on your special day 🎈 You make ordinary moments feel special[[, especially {w}]]. May your year be as beautiful as your heart 🌼 Happy birthday 💛"],
"thinking of you":[
"{n}, you have been in my thoughts more than I can say. [[When I think of {w}, my heart feels quiet and happy at the same time 🌹 ]]I wanted to tell you this honestly, with no pressure at all. If you ever feel even a little of it too, I would love to hear it 💕",
"Dear {n}, some feelings are hard to hold in. [[{w}. ]]Every time I think of you, my day grows softer 🌷 I am telling you simply because it is true, and you deserve to know 💞",
"{n}, I do not know how else to say it, so I will say it simply: you matter to me. [[{w}. ]]You have a way of making my heart feel at home 🌹 Whatever you feel, I just wanted you to know 💕"],
"partner":[
"{n}, from the moment you came into my life, my days felt brighter 💞 [[{w}. ]]I would be honoured to walk beside you, to care for you and to grow with you. Will you be my girlfriend? 🌹",
"Dear {n}, I have been thinking about how to ask this the right way, and I decided to simply be honest 🌷 [[{w}. ]]You are the person I want to share my days with. Will you be my girlfriend? 💞",
"{n}, distance or no distance, my heart keeps finding its way to you 🌹 [[{w}. ]]I promise to treat you with care, respect and love. Would you be mine? 💕"],
"marry":[
"{n}, you have turned my ordinary days into the most beautiful ones 💍 [[{w}. ]]I want every sunrise with you, today and always. Will you marry me? 🌹",
"Dear {n}, I have never been surer of anything in my life 💞 [[{w}. ]]I want to build a home and a lifetime of laughter with you. Will you marry me? 💍",
"{n}, my heart chose you long ago, and every day it chooses you again 🌹 [[{w}. ]]Please do me the greatest honour and say you will marry me 💍"],
"date":[
"Hi {n} 🥂 I would love to take you out on {a} at {b}. I have chosen {c} for a {d}, and I would be so happy if you came with me 🌹 [[{w}. ]]Will you say yes?",
"{n}, I have been looking forward to something and I hope you will too 🌷 On {a} at {b}, at {c}, I would love to share a {d} with you. [[{w}. ]]Say you will come 💕",
"Dear {n}, may I take you out? 🌹 {a}, {b}, {c}, a {d} planned just for the two of us. [[{w}. ]]I promise to make it a lovely evening 🥂"],
"gift":[
"{n}, seeing you smile is my favourite thing 🎁 I would love to surprise you with {a}[[, because {w}]]. You deserve something special 💝 Would you let me?",
"Dear {n}, I have been thinking of a way to make you feel as treasured as you are 🌷 I would like to give you {a}. [[{w}. ]]Please say yes 💞",
"{n}, there is something I would love to do for you: give you {a} 🎁 [[{w}. ]]Not for anything in return, only to see your face light up 💝 May I?"]
};var X={a:"",b:"",c:"",d:""},idx=Math.floor(Math.random()*3);
var EX={"date":["Date (e.g. Saturday 5 December)","Time (e.g. 7pm)","Place (restaurant, park, cinema…)","Kind of date (dinner, picnic, movie…)"],"gift":["What would you like to give them? (e.g. a car, a phone, flowers)"]};
function v(i){return document.getElementById(i).value.trim();}
function setExtra(){var o=v("occasion"),d=document.getElementById("extra"),e=EX[o];d.style.display=e?"block":"none";for(var i=1;i<=4;i++){var f=document.getElementById("x"+i);f.style.display=e&&e[i-1]?"block":"none";f.placeholder=e&&e[i-1]?e[i-1]:"";}}
function setStars(on){
var card=document.getElementById("card");
card.querySelectorAll(".star").forEach(function(e){e.remove();});
if(!on)return;
for(var i=0;i<36;i++){var sp=document.createElement("span");sp.className="star";var z=1+Math.random()*2.6;
sp.style.cssText="left:"+(Math.random()*100)+"%;top:"+(Math.random()*100)+"%;width:"+z+"px;height:"+z+"px;animation-delay:"+(Math.random()*2.6)+"s";card.appendChild(sp);}
}
function applyTheme(s){var th=TH[s],c=document.getElementById("card");c.style.background="linear-gradient(160deg,"+th.c1+","+th.c2+")";c.style.color=th.ink;c.style.setProperty("--gold",th.gold);setStars(th.stars);}
function fill(t,n,w){
return t.replace(/\[\[(.*?)\]\]/g,function(_,s){return w?s:"";}).replace(/\{n\}/g,n).replace(/\{w\}/g,w).replace(/\{a\}/g,X.a).replace(/\{b\}/g,X.b).replace(/\{c\}/g,X.c).replace(/\{d\}/g,X.d);
}
var picP=null;
function makeCard(){
var o=v("occasion"),s=v("style"),n=v("name")||"friend",w=v("words").replace(/[.!\s]+$/,"");
X={a:v("x1")||(o==="gift"?"a special gift":"a day soon"),b:v("x2")||"a time that suits you",c:v("x3")||"a lovely place",d:v("x4")||"special evening"};
var titles={"thank you":"Thank you, "+n,"birthday":"Happy Birthday, "+n,"thinking of you":"Thinking of you, "+n,"partner":"Will you be mine, "+n+"?","marry":"Will you marry me, "+n+"?","date":"A date with you, "+n,"gift":"A gift for you, "+n};
idx=(idx+1)%3;
var card=document.getElementById("card");
card.style.display="block";card.style.animation="none";void card.offsetWidth;card.style.animation="";
applyTheme(s);
document.getElementById("orn").innerText=ornFor(s,o);
document.getElementById("orn2").innerText=ornSmall(s,o);
document.getElementById("title").innerText=titles[o];
document.getElementById("msg").innerText=fill(TPL[o][idx],n,w);
document.getElementById("shareBox").style.display="block";
status("");picP=null;getPic();
}
function plain(){return document.getElementById("msg").innerText;}
function deco(){var s=v("style"),o=v("occasion");return ornFor(s,o)+"\n\n"+document.getElementById("title").innerText+"\n\n"+plain()+"\n\n"+ornSmall(s,o);}
function mode(){return document.querySelector('input[name="mode"]:checked').value;}
function status(t){document.getElementById("status").innerText=t;}
function wrap(ctx,t,x,y,maxW,lh,draw){
var paras=t.split("\n");
for(var p=0;p<paras.length;p++){var words=paras[p].split(" "),line="";
for(var i=0;i<words.length;i++){var test=line?line+" "+words[i]:words[i];
if(ctx.measureText(test).width>maxW&&line){if(draw)ctx.fillText(line,x,y);y+=lh;line=words[i];}else line=test;}
if(draw)ctx.fillText(line,x,y);y+=lh;}
return y;
}
async function makePicBlob(){
var s=v("style"),o=v("occasion"),th=TH[s],W=1080;
try{await document.fonts.load('84px "Dancing Script"');await document.fonts.load('italic 44px "Playfair Display"');}catch(e){}
var title=document.getElementById("title").innerText,msg=plain();
var TF='84px "Dancing Script",cursive',MF='italic 46px "Playfair Display",Georgia,serif';
var m=document.createElement("canvas").getContext("2d");
m.font=TF;var yT=wrap(m,title,W/2,380,820,100,false);
m.font=MF;var yM=wrap(m,msg,W/2,yT+50,820,70,false);
var H=Math.max(1350,yM+300);
var c=document.createElement("canvas");c.width=W;c.height=H;
var ctx=c.getContext("2d");
var g=ctx.createLinearGradient(0,0,W*0.4,H);g.addColorStop(0,th.c1);g.addColorStop(1,th.c2);
ctx.fillStyle=g;ctx.fillRect(0,0,W,H);
if(th.stars){for(var i=0;i<110;i++){var x=Math.random()*W,y=Math.random()*H,r=1+Math.random()*3;
ctx.globalAlpha=.35+Math.random()*.65;ctx.fillStyle="#fff";ctx.beginPath();ctx.arc(x,y,r,0,7);ctx.fill();
if(r>3){ctx.fillRect(x-r*2.5,y-.8,r*5,1.6);ctx.fillRect(x-.8,y-r*2.5,1.6,r*5);}}ctx.globalAlpha=1;}
ctx.strokeStyle=th.gold;ctx.lineWidth=6;ctx.strokeRect(50,50,W-100,H-100);
ctx.lineWidth=2;ctx.strokeRect(78,78,W-156,H-156);
ctx.fillStyle=th.ink;ctx.textAlign="center";
ctx.font="80px serif";ctx.fillText(ornFor(s,o),W/2,230);
ctx.font=TF;wrap(ctx,title,W/2,380,820,100,true);
ctx.font=MF;wrap(ctx,msg,W/2,yT+50,820,70,true);
ctx.font="56px serif";ctx.fillText(ornSmall(s,o),W/2,H-190);
ctx.font="28px Arial";ctx.globalAlpha=.7;ctx.fillText("Made with Gratitude Card Maker",W/2,H-120);ctx.globalAlpha=1;
return new Promise(function(r){c.toBlob(r,"image/png");});
}
function getPic(){if(!picP)picP=makePicBlob();return picP;}
async function shareNow(){
status("Opening your share menu…");
try{
if(mode()==="card"){
var f=new File([await getPic()],"card.png",{type:"image/png"});
if(navigator.canShare&&navigator.canShare({files:[f]})){await navigator.share({files:[f]});status("");return;}
if(navigator.share){await navigator.share({text:deco()});status("");return;}
}else if(navigator.share){await navigator.share({text:plain()});status("");return;}
await navigator.clipboard.writeText(mode()==="card"?deco():plain());
status("Your browser can’t open a share menu, so the message is copied. Paste it in any app.");
}catch(e){
if(e&&e.name==="AbortError"){status("");return;}
status("Sharing didn’t work here. Try opening this page in Chrome on your phone.");
}
}
</script>
</body>
</html>
